<?xml version="1.0" encoding="utf-8"?>
<!-- Latar jendela splash (tampil sebelum layout dimuat) agar tidak ada layar putih -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/header_primary_start"
                android:centerColor="@color/header_primary_mid"
                android:endColor="@color/header_primary_end" />
        </shape>
    </item>
</layer-list>
