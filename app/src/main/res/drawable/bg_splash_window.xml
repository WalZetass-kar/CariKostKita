    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FAF8F2"
                android:centerColor="#F4EFE0"
                android:endColor="#EEEAD7" />
        </shape>
    </item>
</layer-list>
