<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- garis aksen emas di atas kartu -->
    <item android:left="14dp" android:right="14dp" android:height="3dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_gold" />
            <corners android:bottomLeftRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
