<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. Fullscreen Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_pin_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_pin_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_header_curved">

        <ImageButton
            android:id="@+id/btn_pin_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_action_circle"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentukan Lokasi Kost"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Geser peta hingga pin tepat di properti"
                android:textColor="#E0FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Bar on Top of Map -->
    <LinearLayout
        android:id="@+id/layout_pin_search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/layout_pin_header"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_search_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_nav_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/et_pin_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Cari jalan / gedung / area..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pb_pin_search_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_pin_clear_search"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- 3. Fixed Center Target Pin -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:translationY="-24dp"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/iv_center_pin"
            android:layout_width="38dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_map_pin_primary"
            android:contentDescription="Titik Lokasi" />

        <!-- Ground Shadow Circle -->
        <View
            android:layout_width="12dp"
            android:layout_height="4dp"
            android:layout_marginTop="-2dp"
            android:background="@drawable/bg_skeleton_circle"
            android:alpha="0.4" />
    </LinearLayout>

    <!-- 4. Floating 'Gunakan GPS Saya' Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_pin_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/card_pin_location_details"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:fabSize="normal"
        app:backgroundTint="@color/surface"
        app:tint="@color/primary"
        android:src="@drawable/ic_map"
        android:contentDescription="Lokasi Saya"
        app:elevation="4dp" />

    <!-- 5. Bottom Card with Address Summary & Confirm Button -->
    <LinearLayout
        android:id="@+id/card_pin_location_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="10dp"
        android:padding="20dp">

        <!-- Geocoding Loading Bar -->
        <ProgressBar
            android:id="@+id/pb_pin_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_badge_kategori_selected"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Titik Terpilih"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pin_coordinates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0.000000, 0.000000"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pin_street_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Memuat alamat..."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_pin_full_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Geser peta ke lokasi kost Anda"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pin_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Gunakan Titik Ini"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            android:elevation="0dp" />
    </LinearLayout>

</RelativeLayout>
