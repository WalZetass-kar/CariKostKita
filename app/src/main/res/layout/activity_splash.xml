<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: gradient maroon, ornamen, siluet kost yang "naik", logo ber-cincin emas -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_window">

    <ImageView
        android:id="@+id/iv_splash_ornament"
        android:layout_width="220dp"
        android:layout_height="190dp"
        android:layout_gravity="top|end"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/il_header_ornament" />

    <ImageView
        android:id="@+id/iv_splash_skyline"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/il_header_skyline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:id="@+id/frame_splash_logo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:alpha="0"
            android:background="@drawable/bg_splash_logo_ring"
            android:scaleX="0.85"
            android:scaleY="0.85">

            <ImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Logo CariKostKita"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_splash_accent"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:background="@drawable/bg_headline_accent" />

        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:gravity="center"
            android:text="Cari kost terverifikasi di sekitarmu"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Tiga titik pemuatan (dianimasikan) -->
    <LinearLayout
        android:id="@+id/layout_splash_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="164dp"
        android:alpha="0"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_splash_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_splash_dot" />

        <View
            android:id="@+id/dot_splash_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_splash_dot" />

        <View
            android:id="@+id/dot_splash_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_splash_dot" />
    </LinearLayout>
</FrameLayout>
