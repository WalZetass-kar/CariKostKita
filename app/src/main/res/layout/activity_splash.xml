<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Screen: Warm Ivory Hero dengan simbol logo asli, tipografi maroon, aksen emas -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_window">

    <!-- Ornamen sudut atas kanan (motif khas terlihat jelas dan elegan) -->
    <ImageView
        android:id="@+id/iv_splash_ornament"
        android:layout_width="240dp"
        android:layout_height="200dp"
        android:layout_gravity="top|end"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/il_header_ornament"
        app:tint="#386D0808" />

    <!-- Siluet bangunan kost di bagian bawah (siluet kota tegas & artistik) -->
    <ImageView
        android:id="@+id/iv_splash_skyline"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/il_header_skyline"
        app:tint="#406D0808" />

    <!-- Brand Identity Center Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Logo Container (Seamless branding: tanpa bingkai lingkaran kaku) -->
        <FrameLayout
            android:id="@+id/frame_splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0"
            android:scaleX="0.88"
            android:scaleY="0.88">

            <ImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="Logo CariKostKita"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>

        <!-- Nama Brand (Deep Maroon Pekanbaru) -->
        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Aksen Garis Emas Khas -->
        <View
            android:id="@+id/view_splash_accent"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:background="@drawable/bg_headline_accent" />

        <!-- Tagline / Subtitle -->
        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tiga titik pemuatan bernuansa emas (animasi denyut) -->
    <LinearLayout
        android:id="@+id/layout_splash_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="160dp"
        android:alpha="0"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_splash_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_splash_dot" />

        <View
            android:id="@+id/dot_splash_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_splash_dot" />

        <View
            android:id="@+id/dot_splash_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_splash_dot" />
    </LinearLayout>
</FrameLayout>
