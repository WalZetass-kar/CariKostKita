<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Warm Pastel Curved Header Banner (Peach + Soft Pink + Soft Lavender) -->
            <LinearLayout
                android:id="@+id/header_home_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_curved"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="26dp">

                <!-- Top Row: Avatar + Greeting + Notification Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Circular User Avatar -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_home_avatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/surface"
                        android:contentDescription="Avatar Pengguna"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_male"
                        app:shapeAppearanceOverlay="@style/CircleImageOverlay"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1.5dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Halo,"
                            android:textColor="#E0FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_home_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Pencari Kost"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Circular Notification Bell Button -->
                    <FrameLayout
                        android:id="@+id/btn_home_notification"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_header_action_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Notifikasi"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/primary" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Headline -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Mau ngekost di mana hari ini?"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Location Chip Pill (Interactive & Dynamic) -->
                <LinearLayout
                    android:id="@+id/layout_home_location_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_header_location_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_home_location_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Memuat lokasi..."
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#D0FFFFFF" />
                </LinearLayout>

                <!-- Search Bar Trigger + Filter Button -->
                <LinearLayout
                    android:id="@+id/layout_mock_search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_home_search_bar"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search Icon"
                        android:src="@drawable/ic_nav_search"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Cari nama kost, jalan, kelurahan…"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Mini Filter Button in Search Bar -->
                    <FrameLayout
                        android:id="@+id/btn_home_filter_trigger"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_header_action_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Filter"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/primary" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Skeleton Container (Minimum 200ms) -->
            <include
                android:id="@+id/skeleton_home"
                layout="@layout/layout_skeleton_home"
                android:visibility="gone" />

            <!-- Main Content Container -->
            <LinearLayout
                android:id="@+id/layout_home_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Category Filter Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Chip Semua -->
                        <TextView
                            android:id="@+id/chip_home_semua"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Semua"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Putra -->
                        <TextView
                            android:id="@+id/chip_home_putra"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Putra"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Putri -->
                        <TextView
                            android:id="@+id/chip_home_putri"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Putri"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Campur -->
                        <TextView
                            android:id="@+id/chip_home_campur"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Campur"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Informational Banner: "8 kamar kosong baru minggu ini" -->
                <LinearLayout
                    android:id="@+id/banner_kamar_kosong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_info_banner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Sparkle"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tv_banner_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Kamar kosong baru tersedia minggu ini"
                        android:textColor="@color/badge_info_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat ›"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SECTION DISCOVERY: Jelajahi Area Pekanbaru -->
                <LinearLayout
                    android:id="@+id/layout_discovery_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_home_discovery_area_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:text="Jelajahi Area Sekitar"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Area 1: Bukit Raya -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_bukit_raya"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_1_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Bukit Raya"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_1_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Kecamatan"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 2: Tangkerang -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_tangkerang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_2_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Tangkerang"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_2_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Strategis"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 3: Marpoyan -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_marpoyan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_3_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Marpoyan"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_3_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Area Kost"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 4: Simpang Tiga -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_simpang_tiga"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_4_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Simpang Tiga"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_4_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Akses Mudah"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>



                <!-- SECTION 1: Harga Terjangkau (Horizontal Carousel 220dp) -->
                <LinearLayout
                    android:id="@+id/layout_section_terjangkau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Harga terjangkau"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_see_all_terjangkau"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp"
                            android:text="Semua"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_home_carousel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="20dp"
                        android:paddingEnd="6dp" />
                </LinearLayout>

                <!-- SECTION 2: Baru Ditambahkan (Vertical Compact Listing) -->
                <LinearLayout
                    android:id="@+id/layout_section_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tv_home_section_new_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kost di sekitar Anda"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_see_all_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="Semua"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Modern Production-Ready Empty State Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="24dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:contentDescription="Belum Ada Kost"
                            android:src="@drawable/il_empty_kost" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="Belum Ada Kost Tersedia"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Saat ini belum ada kost terdaftar di area ini. Silakan perluas area pencarian atau cari langsung melalui peta."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_empty_expand"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:backgroundTint="@color/primary"
                                android:text="Perluas Area"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_empty_map"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:backgroundTint="@color/soft_blue"
                                android:text="Cari di Peta"
                                android:textAllCaps="false"
                                android:textColor="@color/primary_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main Vertical RecyclerView for Baru Ditambahkan -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_kost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
