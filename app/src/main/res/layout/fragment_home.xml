<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
    
    android:id="@+id/swipe_refresh_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Header: gradient maroon + ornamen + siluet deretan kost (identitas CariKostKita) -->
            <FrameLayout
                android:id="@+id/header_home_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_curved">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="140dp"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:src="@drawable/il_header_ornament" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="22dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/il_header_skyline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="90dp">

                    <!-- Avatar + sapaan + notifikasi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_home_avatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@color/surface"
                            android:contentDescription="Buka profil"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_avatar_male"
                            app:shapeAppearanceOverlay="@style/CircleImageOverlay"
                            app:strokeColor="@color/accent_gold"
                            app:strokeWidth="2dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_home_salam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Halo,"
                                android:textColor="#E6FFFFFF"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_home_greeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Pencari Kost"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/btn_home_notification"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:contentDescription="Pesan masuk"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_header_location_chip">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_bell"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <View
                                android:id="@+id/badge_home_notification"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_dot_active"
                                android:backgroundTint="@color/accent_gold"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Judul + garis aksen emas -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Mau ngekost di mana hari ini?"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_headline_accent" />

                    <!-- Lokasi aktif (bisa diketuk) -->
                    <LinearLayout
                        android:id="@+id/layout_home_location_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_header_location_chip"
                        android:clickable="true"
                        android:contentDescription="Ganti lokasi pencarian"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/accent_gold" />

                        <TextView
                            android:id="@+id/tv_home_location_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="240dp"
                            android:maxLines="1"
                            android:text="Pilih lokasi"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:importantForAccessibility="no"
                            android:rotation="90"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#D0FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Search bar melayang di atas tepi header -->
            <LinearLayout
                android:id="@+id/layout_mock_search"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-27dp"
                android:background="@drawable/bg_home_search_bar"
                android:clickable="true"
                android:contentDescription="Cari kost"
                android:elevation="6dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_search"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_home_search_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Cari nama kost, jalan, kelurahan…"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btn_home_filter_trigger"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_rounded_primary"
                    android:clickable="true"
                    android:contentDescription="Buka peta kost"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_map"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Alasan percaya: 3 kartu mini seragam; semua klaim sesuai fitur yang benar-benar ada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/trust_card_verified"
                    layout="@layout/item_trust_card" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/trust_card_chat"
                    layout="@layout/item_trust_card" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/trust_card_map"
                    layout="@layout/item_trust_card" />
            </LinearLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:id="@+id/layout_home_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Category Filter Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Chip Semua -->
                        <TextView
                            android:id="@+id/chip_home_semua"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Semua"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Putra -->
                        <TextView
                            android:id="@+id/chip_home_putra"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Putra"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Putri -->
                        <TextView
                            android:id="@+id/chip_home_putri"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Putri"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Chip Campur -->
                        <TextView
                            android:id="@+id/chip_home_campur"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_badge_kategori_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Campur"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Informational Banner: "8 kamar kosong baru minggu ini" -->
                <LinearLayout
                    android:id="@+id/banner_kamar_kosong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_info_banner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tv_banner_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Lihat kost yang masih punya kamar kosong"
                        android:textColor="@color/badge_info_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat ›"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SECTION DISCOVERY: Jelajahi Area Pekanbaru -->
                <LinearLayout
                    android:id="@+id/layout_discovery_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:drawableStart="@drawable/ic_section_accent"
                        android:drawablePadding="10dp"
                        android:id="@+id/tv_home_discovery_area_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:text="Jelajahi Area Sekitar"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Area 1: Bukit Raya -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_bukit_raya"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_1_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Bukit Raya"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_1_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Kecamatan"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 2: Tangkerang -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_tangkerang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_2_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Tangkerang"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_2_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Strategis"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 3: Marpoyan -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_marpoyan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_3_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Marpoyan"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_3_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Area Kost"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Area 4: Simpang Tiga -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_area_simpang_tiga"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="10dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Pin"
                                        android:src="@drawable/ic_location_pin"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_area_4_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Simpang Tiga"
                                            android:textColor="@color/text_primary"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_area_4_sub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Akses Mudah"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>



                <!-- SECTION 1: Harga Terjangkau (Horizontal Carousel 220dp) -->
                <LinearLayout
                    android:id="@+id/layout_section_terjangkau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_headline_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Harga terjangkau"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_see_all_terjangkau"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp"
                            android:text="Semua"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_home_carousel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="20dp"
                        android:paddingEnd="6dp" />
                </LinearLayout>

                <!-- SECTION 2: Baru Ditambahkan (Vertical Compact Listing) -->
                <LinearLayout
                    android:id="@+id/layout_section_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_headline_accent" />

                    <TextView
                        android:id="@+id/tv_home_section_new_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kost di sekitar Anda"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_see_all_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="Semua"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Modern Production-Ready Empty State Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="24dp">

                        <ImageView
                            android:id="@+id/iv_home_empty_icon"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/il_empty_kost" />

                        <TextView
                            android:id="@+id/tv_home_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="Belum Ada Kost Tersedia"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_home_empty_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Saat ini belum ada kost terdaftar di area ini. Silakan perluas area pencarian atau cari langsung melalui peta."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_empty_expand"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:backgroundTint="@color/primary"
                                android:text="Perluas Area"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_empty_map"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:backgroundTint="@color/soft_blue"
                                android:text="Cari di Peta"
                                android:textAllCaps="false"
                                android:textColor="@color/primary_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main Vertical RecyclerView for Baru Ditambahkan -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_kost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Skeleton satu halaman penuh (shimmer), menutupi seluruh layar saat pemuatan pertama -->
    <include
        android:id="@+id/skeleton_home"
        layout="@layout/layout_skeleton_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
