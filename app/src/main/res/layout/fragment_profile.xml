<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <!-- Header Section with Warm Pastel Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curved"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="42dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil Saya"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Kelola akun, status peran, dan preferensi aplikasi"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Skeleton Profile (Minimum 200ms) -->
        <include
            android:id="@+id/skeleton_profile"
            layout="@layout/layout_skeleton_profile"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="-24dp">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0.5dp"
                app:contentPadding="20dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Avatar with Camera Badge -->
                    <FrameLayout
                        android:id="@+id/layout_avatar_container"
                        android:layout_width="84dp"
                        android:layout_height="84dp">

                        <ImageView
                            android:id="@+id/iv_profile_avatar"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:contentDescription="Avatar"
                            android:src="@drawable/ic_avatar_male" />

                        <!-- Camera Edit Badge Button -->
                        <FrameLayout
                            android:id="@+id/btn_edit_avatar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_fav_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Ubah Foto"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/primary" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Name -->
                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pengguna CariKostKita"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Email -->
                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="email@akun.com"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Phone Number -->
                    <TextView
                        android:id="@+id/tv_profile_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="No. WhatsApp: Belum diatur"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Bio -->
                    <TextView
                        android:id="@+id/tv_profile_bio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Belum ada bio singkat."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Role Badge (Netral, bukan hijau) -->
                    <TextView
                        android:id="@+id/tv_profile_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge_role_neutral"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="Pencari Kost"
                        android:textColor="@color/role_neutral_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Button Edit Profile -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_profile"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:text="Ubah Data Profil &amp; Bio"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1.2dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Owner Verification Card (With Left Maroon Red Accent) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_owner_verification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/primary_soft"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Left Red Maroon Accent Stripe (4dp) -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary" />

                    <!-- Verification Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_verification_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Info"
                                android:src="@drawable/ic_info"
                                app:tint="@color/primary" />

                            <TextView
                                android:id="@+id/tv_verification_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Ingin Mengiklankan Kost?"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_verification_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Ajukan akun Anda untuk diverifikasi sebagai pemilik kost agar dapat memasang dan mengelola properti di CariKostKita."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_apply_owner"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/primary"
                            android:text="Ajukan Verifikasi Pemilik Kost"
                            android:textColor="@color/on_primary"
                            android:textSize="13sp"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account Security & Settings Card (Single list card with radius 18dp) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Favorit Saya Item -->
                    <LinearLayout
                        android:id="@+id/item_my_favorites"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Favorit"
                            android:src="@drawable/ic_nav_favorite"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Kost Favorit Tersimpan"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Arrow"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Ganti Kata Sandi Item -->
                    <LinearLayout
                        android:id="@+id/item_change_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Password"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Keamanan &amp; Ganti Kata Sandi"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Arrow"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Notifikasi Item -->
                    <LinearLayout
                        android:id="@+id/item_notification_settings"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Notifikasi"
                            android:src="@drawable/ic_info"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Notifikasi Chat &amp; Aktivitas"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_notification_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aktif"
                            android:textColor="@color/status_tersedia"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Tentang Aplikasi Item -->
                    <LinearLayout
                        android:id="@+id/item_about_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tentang CariKostKita"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="CariKostKita Mobile v1.0.0\nWilayah Operasional: Seluruh Indonesia\nPlatform: Native Android Java"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Keluar dari Akun"
                android:textColor="@color/status_penuh"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/status_penuh"
                app:strokeColor="@color/status_penuh"
                app:strokeWidth="1.2dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
