<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout 
    
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Search Header Section -->
    <LinearLayout
        android:id="@+id/header_search_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <!-- Band header bermotif (sama dengan Beranda) -->
        <FrameLayout
            android:id="@+id/header_search_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curved">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="120dp"
                android:layout_gravity="top|end"
                android:importantForAccessibility="no"
                android:src="@drawable/il_header_ornament" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/il_header_skyline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cari Kost"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ketik nama, jalan, atau area. Hasil langsung muncul."
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_headline_accent" />

            <!-- Dominant Search Bar Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="0dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search"
                        android:src="@drawable/ic_nav_search"
                        app:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/et_search_query"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_search_clear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Hapus teks pencarian"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Filter Button with Active Badge Counter -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp">

                    <ImageButton
                        android:id="@+id/btn_open_filter"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_chip_filter_active"
                        android:contentDescription="Filter lengkap"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/primary" />

                    <!-- Badge Angka Filter Aktif -->
                    <TextView
                        android:id="@+id/tv_filter_badge_count"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_pill_penuh"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Map Search Button -->
                <ImageButton
                    android:id="@+id/btn_search_open_map"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_filter_active"
                    android:contentDescription="Lihat di peta"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_map"
                    app:tint="@color/primary" />

            </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Horizontal Quick Filter Chips with Right-Edge Fading -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="32dp"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_search_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:contentDescription="Cari kost dekat tujuan seperti kampus atau kantor"
                    android:drawableStart="@drawable/ic_chip_map"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/primary"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="Dekat tujuan"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_search_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_kategori_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Semua"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_search_putri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Putri"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_search_putra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Putra"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_search_campur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Campur"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_search_under_1jt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="&lt; 1 Jt"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_search_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Ada kamar"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Riwayat pencarian (tampil saat kolom kosong) -->
        <HorizontalScrollView
            android:id="@+id/hsv_search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_search_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- Filter aktif dari sheet filter (ketuk X untuk menghapus) -->
        <HorizontalScrollView
            android:id="@+id/hsv_search_active_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_search_active_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- Result Stats & Sorting Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_search_results_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Menampilkan semua kost"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Sort Selector Chip -->
            <LinearLayout
                android:id="@+id/btn_sort_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <TextView
                    android:id="@+id/tv_current_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urutkan: Terbaru"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Sort Icon"
                    android:rotation="270"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_muted" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Skeleton Shimmer Placeholder List -->
        <com.carikostkita.ui.view.ShimmerView
            android:id="@+id/layout_search_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp">

            <include layout="@layout/item_kost_skeleton" />
            <include layout="@layout/item_kost_skeleton" />
            <include layout="@layout/item_kost_skeleton" />
            <include layout="@layout/item_kost_skeleton" />
        </LinearLayout>
        </com.carikostkita.ui.view.ShimmerView>

        <ProgressBar
            android:id="@+id/pb_search_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        
        <LinearLayout
            android:id="@+id/layout_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_fav_circle">

                <ImageView
                    android:id="@+id/iv_search_empty_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_search"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_search_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/empty_kost_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_search_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tidak ada kost yang sesuai dengan kriteria filter saat ini."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_search"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Reset Filter"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Results Recycler View with padding for bottom nav -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="6dp"
            android:paddingBottom="96dp" />

    </FrameLayout>

</LinearLayout>

    <!-- Skeleton satu halaman penuh (shimmer), menutupi seluruh layar saat pemuatan pertama -->
    <include
        android:id="@+id/skeleton_search_full"
        layout="@layout/layout_skeleton_search_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
