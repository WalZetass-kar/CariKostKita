<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="110dp"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Photo Thumbnail -->
        <ImageView
            android:id="@+id/iv_form_foto_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Thumbnail Foto"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_bed" />

        <!-- Badge Cover / Foto Utama -->
        <TextView
            android:id="@+id/tv_badge_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_putri"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Utama"
            android:textColor="@color/primary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btn_form_foto_delete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_fav_circle"
            android:contentDescription="Hapus Foto"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="#DC2626" />

        <!-- Button Set as Main (at bottom) -->
        <TextView
            android:id="@+id/btn_set_cover"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:text="Jadikan Utama"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
