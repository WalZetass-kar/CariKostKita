<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_kost_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Left Thumbnail Container (92dp x 104dp) -->
        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="104dp">

            <!-- Rounded Mask Container for Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_kost_thumbnail"
                android:layout_width="92dp"
                android:layout_height="104dp"
                android:contentDescription="Foto Kost"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.CariKostKita.ThumbRadius14" />

            <!-- Placeholder Gradient Layout (when no image) -->
            <LinearLayout
                android:id="@+id/layout_thumb_placeholder"
                android:layout_width="92dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_thumb_placeholder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Placeholder"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/placeholder_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Foto belum\ntersedia"
                    android:textColor="@color/placeholder_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Category Badge Overlaid on Thumbnail Top-Left -->
            <TextView
                android:id="@+id/tv_badge_tipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:background="@drawable/bg_badge_putri"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="PUTRI"
                android:textColor="@color/badge_putri"
                android:textSize="11sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Right Info Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Title & Favorite Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_kost_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kost Melati Bukit Raya"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_favorite_toggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Simpan Favorit"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline" />
            </LinearLayout>

            <!-- Location with Pin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Lokasi"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_kost_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Simpang Tiga, Bukit Raya"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Facilities & Specs Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_kost_room_specs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_kategori_unselected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="3x4 m"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_kost_facilities"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AC • WiFi • K. Mandi"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Price & Availability Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_kost_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rp750.000 /bulan"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Single Availability Pill: "2 kamar" (Green) or "Penuh" (Soft Red) -->
                <TextView
                    android:id="@+id/tv_kost_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_tersedia"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="2 kamar"
                    android:textColor="@color/status_tersedia"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
