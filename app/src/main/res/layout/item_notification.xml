<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card.CariKost"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/container_notif_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_putra"
            android:padding="8dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Notifikasi Sistem"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pesan notifikasi lengkap akan tampil di sini."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tv_notif_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Baru saja"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/dot_notif_unread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_active" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
