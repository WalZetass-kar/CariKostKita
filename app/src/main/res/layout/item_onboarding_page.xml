<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <!-- Slide Hero Illustration -->
    <ImageView
        android:id="@+id/iv_onboard_image"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="Ilustrasi Onboarding"
        android:src="@drawable/il_onboarding_house" />

    <!-- Slide Title -->
    <TextView
        android:id="@+id/tv_onboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="Temukan Kost yang Cocok"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Slide Subtitle / Description -->
    <TextView
        android:id="@+id/tv_onboard_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Pilih hunian kost impian dengan filter lengkap, fasilitas detail, dan informasi terpercaya."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
