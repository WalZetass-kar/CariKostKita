<?xml version="1.0" encoding="utf-8"?>
<!-- Baris update cepat kamar kosong: nama kost + stepper −/+ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_quick_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_quick_room_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_quick_room_minus"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Kurangi kamar kosong"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="−"
        android:textColor="@color/primary"
        android:textSize="20sp"
        app:cornerRadius="22dp"
        app:strokeColor="@color/border_subtle" />

    <TextView
        android:id="@+id/tv_quick_room_value"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_quick_room_plus"
        style="@style/Widget.Material3.Button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:backgroundTint="@color/primary"
        android:contentDescription="Tambah kamar kosong"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/on_primary"
        android:textSize="20sp"
        app:cornerRadius="22dp" />
</LinearLayout>
