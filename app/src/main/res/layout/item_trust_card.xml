<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu mini "alasan percaya" di Beranda: ukuran seragam (lebar dibagi rata) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_trust_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="96dp"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_trust_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_bubble_gold"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tv_trust_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_trust_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
