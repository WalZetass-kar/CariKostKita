<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@drawable/bg_floating_bottom_nav"
    android:elevation="6dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/nav_admin_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- Tab 0: Dashboard -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_pill_active"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_admin_nav_dashboard"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Dashboard"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_admin_nav_dashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dashboard"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 1: Verifikasi -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_verif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_verif"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_admin_nav_verif"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Verifikasi"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/text_secondary" />

                    <View
                        android:id="@+id/badge_unread_admin_verif"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_dot_active"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_admin_nav_verif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Verifikasi"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 2: Data Kost & Master -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_data"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_data"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_admin_nav_data"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Data Master"
                    android:src="@drawable/ic_bed"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_admin_nav_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Data Kost"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 3: Laporan -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_laporan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_laporan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_admin_nav_laporan"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Laporan"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_admin_nav_laporan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Laporan"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 4: Log Audit -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_log"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_log"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_admin_nav_log"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Log Audit"
                    android:src="@drawable/ic_activity"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_admin_nav_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Log"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 5: Profil -->
        <FrameLayout
            android:id="@+id/tab_admin_nav_profil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_admin_profil"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_admin_nav_profil"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Profil Admin"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_admin_nav_profil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Profil"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
