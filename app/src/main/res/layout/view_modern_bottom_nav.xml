<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_bottom_nav"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Sliding Active Capsule Indicator (Behind the active icon) -->
    <View
        android:id="@+id/nav_active_indicator"
        android:layout_width="60dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_nav_capsule"
        android:visibility="invisible" />

    <!-- 4 Navigation Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- Tab: Beranda -->
        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/iv_tab_home"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_tab_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab: Cari -->
        <LinearLayout
            android:id="@+id/tab_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/iv_tab_search"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_search"
                    android:src="@drawable/ic_nav_search"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_tab_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_search"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tab: Favorit -->
        <LinearLayout
            android:id="@+id/tab_favorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/iv_tab_favorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_favorite"
                    android:src="@drawable/ic_nav_favorite"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_tab_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_favorite"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tab: Profil -->
        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/iv_tab_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_tab_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_profile"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
