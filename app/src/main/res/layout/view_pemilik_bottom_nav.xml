<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/bg_floating_bottom_nav"
    android:elevation="6dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/nav_pemilik_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <!-- Tab 0: Dashboard -->
        <FrameLayout
            android:id="@+id/tab_pemilik_nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_pemilik_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_pill_active"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iv_pemilik_nav_dashboard"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Dashboard"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_pemilik_nav_dashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dashboard"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 1: Kost Saya -->
        <FrameLayout
            android:id="@+id/tab_pemilik_nav_kost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_pemilik_kost"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iv_pemilik_nav_kost"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Kost Saya"
                    android:src="@drawable/ic_bed"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_pemilik_nav_kost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kost Saya"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 2: Pesan -->
        <FrameLayout
            android:id="@+id/tab_pemilik_nav_pesan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_pemilik_pesan"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_pemilik_nav_pesan"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Pesan"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="@color/text_secondary" />

                    <View
                        android:id="@+id/badge_unread_pemilik_chat"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-2dp"
                        android:background="@drawable/bg_skeleton_circle"
                        android:backgroundTint="@color/primary"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_pemilik_nav_pesan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Pesan"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 3: Profil -->
        <FrameLayout
            android:id="@+id/tab_pemilik_nav_profil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/pill_pemilik_profil"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iv_pemilik_nav_profil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Profil"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_pemilik_nav_profil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Profil"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
