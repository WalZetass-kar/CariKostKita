<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CariKostKita" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Clean Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border</item>

        <!-- Modern Clean Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Splash Screen Theme (Maroon Hero) -->
    <style name="Theme.CariKostKita.Splash" parent="Theme.CariKostKita">
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:statusBarColor">@color/header_primary_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <!-- Thumbnail Rounded Corner ShapeAppearances -->
    <style name="ShapeAppearance.CariKostKita.ThumbRadius14" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.CariKostKita.ThumbRadius16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Circle ShapeAppearance for Avatars -->
    <!-- ===== Sistem komponen CariKostKita (hangat & bermotif) ===== -->
    <style name="Card.CariKost" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/ck_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/ck_card_padding</item>
    </style>

    <style name="Card.CariKost.Flush">
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Button.CariKost.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ck_button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Button.CariKost.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ck_button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Text.Section.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section.Caption" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Baris menu pengaturan: ikon dalam gelembung + judul + subjudul + aksi kanan -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ck_setting_row_min</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingRow.Icon" parent="">
        <item name="android:layout_width">@dimen/ck_icon_bubble</item>
        <item name="android:layout_height">@dimen/ck_icon_bubble</item>
        <item name="android:background">@drawable/bg_icon_bubble</item>
        <item name="android:padding">10dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/primary</item>
    </style>

    <style name="SettingRow.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingRow.Subtitle" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Chip kecil "alasan percaya" di bawah search bar Beranda -->
    <style name="TrustChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_trust_chip</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CircleImageOverlay" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
