<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CariKostKita" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Clean Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border</item>

        <!-- Modern Clean Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Splash Screen Theme (Maroon Hero) -->
    <style name="Theme.CariKostKita.Splash" parent="Theme.CariKostKita">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <!-- Thumbnail Rounded Corner ShapeAppearances -->
    <style name="ShapeAppearance.CariKostKita.ThumbRadius14" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.CariKostKita.ThumbRadius16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Circle ShapeAppearance for Avatars -->
    <style name="CircleImageOverlay" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
